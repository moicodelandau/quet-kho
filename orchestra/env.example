# Copy to ~/.orchestra/.env  (chmod 600). Leave unused providers blank — they are skipped.

# Gemini CLI: run `gemini` once interactively and "Login with Google" (AI Pro account),
# or set GEMINI_API_KEY for API billing. Optional model override:
GEMINI_MODEL=

# Antigravity CLI. Extra flags as a JSON array, placed before -p. Verify names with `agy --help`.
# Example (UNVERIFIED flag names): ["--output-format","text","--dangerously-skip-permissions"]
AGY_ARGS=

# OpenRouter (free models). Get key at openrouter.ai/keys. Run `ask list-free`, pick 2-3:
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# DeepSeek official API (paid, very cheap): platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# xAI Grok API: console.x.ai. Set a current model id from docs.x.ai.
XAI_API_KEY=
XAI_MODEL=

# Qwen via Alibaba DashScope (intl). New accounts have historically received a free token quota.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
